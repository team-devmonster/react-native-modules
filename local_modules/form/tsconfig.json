{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "jsx": "react-native",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["react", "node"],
    "moduleResolution": "node",
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "outDir": "dist/esm",
    "sourceMap": true,
    "strict": true,
    "target": "es6",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@team-devmonster/react-native-tags": ["../tags/dist/esm/index"],
      "@team-devmonster/react-native-router": ["../router/dist/esm/index"]
    }
  },
  "include": ["**/*.ts", "src/**/*.tsx", "src/**/*.ts"]
}